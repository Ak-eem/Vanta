# Existing Vanta provider (kept for legacy chat and final fallback paths)
GROQ_API_KEY=

# OpenRouter dual-model supervisor
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FLASH_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_BRAIN_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BRAIN_FALLBACK_MODEL=z-ai/glm-5.2:free

# Browser automation is opt-in; use auto or on to enable it.
BROWSER_AUTOMATION=manual

# Local conservative caps: 20 requests/minute and 50 free requests/day.
OPENROUTER_RPM_LIMIT=20
OPENROUTER_DAILY_LIMIT=50
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Vanta

# Existing Vanta settings
VANTA_MODEL=openai/gpt-oss-120b
VANTA_AGENT_NAME=Vanta
VANTA_USER_NAME=Akeem Ganikale
VANTA_WORKSPACE=~/vanta_workspace

# Read in code but previously missing here — all optional, safe defaults shown
FLASK_SECRET=                                      # Flask session secret; defaults to "vanta-v4" if unset
OPENWEATHER_API_KEY=                               # Real-time weather; falls back to Google search if unset
PORT=5000                                          # server.py __main__ port
VISION_CRITIQUE_MODEL=                             # Optional override for the visual-critique vision model

# Free Gemini (https://aistudio.google.com/apikey) — second provider in the pool
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM_LIMIT=10
GEMINI_DAILY_LIMIT=200

# Local fallback model (install Ollama from ollama.com, then: ollama pull qwen2.5:3b)
VANTA_LOCAL_ENABLED=true
VANTA_LOCAL_MODEL=qwen2.5:3b

# Route lookups ("route to Ikeja") use free OpenStreetMap services with no key.
# Optional: your own OSRM servers, and a fixed start point instead of VANTA_DEFAULT_CITY.
# VANTA_OSRM_URL=https://router.project-osrm.org
# VANTA_OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# VANTA_OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
# VANTA_ORIGIN=
