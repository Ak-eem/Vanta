{
  "manifest_version": 3,
  "name": "VANTA Eyes",
  "version": "0.1.0",
  "description": "Lets your local VANTA read the page you're on (text only, never passwords). Talks only to your own computer.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:5000/*", "http://localhost:5000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "options_page": "options.html"
}
